generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  COORDINATOR
  ADMIN
}

enum SnapshotProcessingStatus {
  IN_REVIEW
  PROCESSED
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id                   String                @id @default(cuid())
  name                 String                @unique
  description          String                @default("")
  economicSector       String                @default("")
  classification       String                @default("")
  headcount            String                @default("")
  revenueUSD           String                @default("")
  avgProfitPercent     String                @default("")
  hrName               String                @default("")
  hrPosition           String                @default("")
  hrEmail              String                @default("")
  hrPhone              String                @default("")
  hrCell               String                @default("")
  minVacationDays      String                @default("")
  minUtilityDays       String                @default("")
  conversionRate       String                @default("")
  locality             String                @default("")
  users                User[]
  snapshots            UserSnapshot[]
  positions            UserPosition[]
  editRequests         EditRequest[]
  estudioCargos        EstudioCargo[]
  estudioEquivalencias EstudioEquivalencia[]
  estudioInformes      EstudioInforme[]
  estudioEnabled       Boolean               @default(false)
  estudioSnapshotIds   String                @default("[]")
  /// Cuántos cortes de data distintos puede configurar en cada estudio.
  /// Mapa snapshotId -> cupo; lo que no esté vale CUPO_POR_DEFECTO.
  estudioCuposJson     String                @default("{}")
  solicitudesInforme   SolicitudInforme[]
  auditoriasSuavizado  AuditoriaSuavizado[]
  /// Informe General de Tendencias Salariales: se habilita y se elige qué
  /// cortes puede descargar, igual que el Estudio de Competitividad.
  generalEnabled       Boolean               @default(false)
  generalSnapshotIds   String                @default("[]")
  /// Qué informes de beneficios no salariales tiene autorizados. Son globales,
  /// no dependen del corte, y pueden ser varios: una empresa puede comprar el
  /// del mercado general y el de su sector.
  beneficiosInformeIds String                @default("[]")

  /// Radar Salarial: el reporte suelto de UN cargo o UN grado.
  radarEnabled        Boolean        @default(false)
  /// Cuántos puede bajar por trimestre. Null = el tope general del sistema.
  radarCupoTrimestral Int?
  radarInformes       RadarInforme[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model User {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role           UserRole       @default(USER)
  name           String
  email          String
  passwordHash   String
  passwordPlain  String?
  workspace      UserWorkspace?
  snapshots      UserSnapshot[]
  positions      UserPosition[]
  editRequests   EditRequest[]
  lastLoginAt    DateTime?
  sessionVersion Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([email, companyId])
}

model UserWorkspace {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inflation          Float     @default(5)
  snapshotsJson      String    @default("{}")
  selectedSnapshotId String?
  companyInfoJson    String    @default("{}")
  lastExportAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model UserSnapshot {
  id          String                   @id @default(cuid())
  userId      String
  companyId   String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshotId  String
  label       String
  date        DateTime
  status      SnapshotProcessingStatus @default(IN_REVIEW)
  processedAt DateTime?
  submittedAt DateTime?
  positions   UserPosition[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([userId, snapshotId])
  @@index([companyId, date])
}

model UserPosition {
  id             String       @id @default(cuid())
  userId         String
  companyId      String
  userSnapshotId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshot       UserSnapshot @relation(fields: [userSnapshotId], references: [id], onDelete: Cascade)
  snapshotId     String
  snapshotLabel  String
  snapshotDate   DateTime
  positionId     String
  title          String?
  dataJson       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, snapshotId, positionId])
  @@index([userId, snapshotDate])
  @@index([companyId, snapshotDate])
  @@index([userSnapshotId])
}

/// Un informe de beneficios no salariales: un PDF que arma AC Consulting
/// fuera de la plataforma y que acá solo se guarda y se reparte.
///
/// El archivo va en base64 en la misma base, como la imagen de un anuncio: son
/// pocos, pesan un par de megas y no hay almacenamiento de archivos montado.
/// Si algún día son muchos o pesan más, esto se muda a un bucket.
model InformeBeneficios {
  id            String   @id @default(cuid())
  titulo        String
  /// El nombre con el que se descarga, con extensión.
  nombreArchivo String   @default("")
  /// El PDF en base64, sin el prefijo `data:`.
  archivo       String
  bytes         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Un cliente que agotó su cupo de informes en un estudio y pide más.
///
/// El cupo no limita descargas: limita cuántos cortes de data distintos puede
/// configurar. Los que ya configuró los baja las veces que quiera.
model SolicitudInforme {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshotId    String
  snapshotLabel String            @default("")
  motivo        String            @default("")
  status        EditRequestStatus @default(PENDING)
  /// Cuántos informes le otorgó el admin al aprobar.
  otorgados     Int               @default(0)
  resueltoPor   String            @default("")
  resueltoEn    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, companyId])
  @@index([companyId, snapshotId])
}

/// La foto del suavizado de un informe, para auditarlo después.
///
/// Guarda la matriz cruda, la que vio el cliente y qué hizo el algoritmo. Sin
/// esto no hay forma de revisar, meses más tarde, si las líneas de tendencia
/// estaban ajustando bien o si el modelo necesita cambios.
model AuditoriaSuavizado {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshotId       String
  snapshotLabel    String   @default("")
  /// Contra qué grupo de mercado se comparó, en palabras.
  grupoComparacion String   @default("")
  /// Los filtros del grupo, como viajan en la URL.
  filtros          String   @default("")
  /// Qué métrica se publicó en el informe.
  metrica          String   @default("")
  /// Cruda, procesada y diagnóstico de las cuatro métricas.
  datosJson        String
  /// Con qué tasas se calculó: las cuatro globales del momento y qué TCR se
  /// pidió. Es lo que permite reproducir un informe viejo y explicar de dónde
  /// salió cada cifra.
  tasasJson        String   @default("{}")
  generadoPor      String   @default("")
  createdAt        DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([snapshotId, createdAt])
}

model GlobalConfig {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model EditRequest {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshotId     String
  reason         String?
  status         EditRequestStatus @default(PENDING)
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([snapshotId, status])
  @@index([companyId])
  @@index([userId, snapshotId, status])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  type        String    @default("aviso")
  published   Boolean   @default(false)
  publishedAt DateTime?
  sortOrder   Int       @default(0)
  mediaData   String?
  mediaUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Un ocupante de la lista propia de una empresa para el Estudio de Competitividad.
///
/// La fila es la PERSONA, no el cargo: en el estudio de competitividad una empresa
/// puede tener tres analistas con sueldos distintos, y el Análisis de Equidad
/// Interna existe justamente para compararlos entre sí. En el estudio de
/// mercado eso no pasa — ahí va un cargo por empresa, y de eso se encarga
/// `UserPosition`, que sí rechaza títulos repetidos.
model EstudioCargo {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Identificador del ocupante que usa el cliente (p. ej. "TEALCA-001").
  /// Opcional: si no lo trae, la fila igual vale. Es nulo y no cadena vacía
  /// porque en Postgres los nulos no chocan entre sí en un índice único.
  ocupanteId       String?
  departamento     String   @default("")
  tituloCargo      String
  descripcion      String   @default("")
  /// A qué cargo reporta. Lo pide el informe de competitividad para armar el mapeo
  /// de cargos; solo aplica a este estudio, no a la captura del mercado.
  reportaA         String   @default("")
  hayGrade         Int?
  capriFamily      String?
  /// Estructura de compensación, con la misma forma que UserPosition.dataJson,
  /// para poder reusar la pantalla de compensación y computeRowTotals sin cambios.
  dataJson         String   @default("{}")
  /// manual | importado — de dónde salió. Un importado es una copia editable:
  /// tocarlo no afecta la data enviada del corte de origen.
  origen           String   @default("manual")
  origenSnapshotId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, ocupanteId])
  @@index([companyId])
  @@index([companyId, tituloCargo])
}

/// A qué cargo del catálogo equivale un cargo del cliente, POR CORTE.
///
/// Va por CARGO y no por ocupante: los tres analistas de una empresa comparan
/// todos contra el mismo cargo del catálogo. Guardarla por persona obligaría a
/// homologar tres veces y dejaría que quedaran distintas entre sí.
model EstudioEquivalencia {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Título del cargo del cliente, normalizado (sin acentos, en minúsculas).
  tituloCargoKey String
  snapshotId     String
  departamento   String   @default("")
  tituloCatalogo String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, tituloCargoKey, snapshotId])
  @@index([snapshotId])
}

/// Un informe generado por el cliente para un estudio.
///
/// Guarda una FOTO CONGELADA: los cargos con sus montos y los percentiles del
/// mercado tal como estaban al generarlo. Un informe entregado nunca cambia
/// solo — si el cliente corrige un sueldo o se republica el corte, genera uno
/// nuevo, el viejo sigue diciendo lo mismo.
model EstudioInforme {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nombre        String
  snapshotId    String
  snapshotLabel String   @default("")
  /// La foto: filas con montos propios y percentiles de mercado, más con qué
  /// criterio se armó (modo y métrica).
  datosJson     String
  /// Huella de la configuración del corte de data: mismo corte, modo, métrica,
  /// TCR, comisiones, grados y filtros. Dos informes con la misma huella son
  /// el mismo corte, así que el segundo no consume cupo.
  configHash    String   @default("")
  generadoPor   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, createdAt])
}

/// Un informe del Radar Salarial, congelado tal como se emitió.
///
/// Se guarda entero y no por referencia: el corte del que se saca el Radar lo
/// cambia el administrador cada tanto, y un informe ya entregado no puede
/// cambiar de cifras porque el corte de origen dejó de ser el vigente.
model RadarInforme {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Quién lo generó, para el historial.
  generadoPor   String   @default("")
  snapshotId    String
  snapshotLabel String   @default("")
  /// "cargo" cuando sale del catálogo, "grado" cuando se valoró con CAPRI.
  modo          String
  /// El trimestre que consume, escrito "2026-T4": el cupo es trimestral y así
  /// se cuenta sin volver a calcular fechas en cada consulta.
  trimestre     String
  /// Cómo se llama en el historial: el cargo, o el cargo valorado.
  titulo        String
  /// El informe completo —perfil, muestra y percentiles— para poder volver a
  /// bajarlo sin recalcular nada.
  datosJson     String
  createdAt     DateTime @default(now())

  @@index([companyId, trimestre])
  @@index([companyId, createdAt])
}

/// Una persona pidiendo acceso al Market Analyzer desde la página pública.
///
/// No cuelga de Company ni de User a propósito: quien la manda todavía no es
/// nadie dentro del sistema, y la empresa que escribe puede no existir. Es la
/// única tabla que se escribe sin sesión, así que la ruta que la llena va con
/// tope por IP (AC Consulting, 2026-10-21).
///
/// El circuito es el mismo que el de las solicitudes de edición: llega
/// PENDING, el admin la acepta o la deniega, y recién después crea el usuario.
/// Aceptar y crear son dos pasos distintos porque el admin puede aceptar hoy y
/// crear cuando tenga la empresa dada de alta; mientras tanto la solicitud
/// queda aprobada y sin usuario, que es lo que la bandeja marca como
/// pendiente de crear.
model SolicitudAcceso {
  id              String            @id @default(cuid())
  /// Quién la manda.
  nombre          String
  correo          String
  cargo           String            @default("")
  telefono        String            @default("")
  /// Su empresa, tal como la escribió. Puede no existir todavía.
  empresa         String
  sector          String            @default("")
  clasificacion   String            @default("")
  headcount       String            @default("")
  localidad       String            @default("")
  /// A qué se dedica la empresa, en sus palabras.
  actividad       String            @default("")
  /// Por dónde se enteró del Market Analyzer. Una de `CANALES_ACCESO`.
  comoSeEntero    String            @default("")
  status          EditRequestStatus @default(PENDING)
  /// Por qué se denegó. Es nota interna: no se le muestra a quien solicitó.
  motivoRechazo   String            @default("")
  resueltoPor     String            @default("")
  resueltoEn      DateTime?
  /// El usuario que salió de esta solicitud, si ya se creó.
  usuarioCreadoId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([correo])
}

/// Un videotutorial, del Centro de Ayuda o de la Academia C&B.
///
/// Las dos secciones son la misma cosa con distinta intención —una enseña a
/// usar la plataforma, la otra enseña Compensación y Beneficios— así que
/// comparten tabla y componente y se separan por `categoria`. Van en el menú
/// aparte a propósito, para que no se confunda el soporte técnico con la
/// formación profesional (AC Consulting, 2026-10-27).
///
/// El video es siempre un enlace de YouTube: no se sube nada a la plataforma,
/// igual que en los anuncios.
model RecursoFormacion {
  id          String   @id @default(cuid())
  /// "ayuda" o "academia". Texto y no enum para poder sumar secciones sin migrar.
  categoria   String
  titulo      String
  descripcion String   @default("")
  /// La URL tal como la pegó el admin; el id se extrae al mostrarla.
  videoUrl    String
  publicado   Boolean  @default(false)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoria, publicado, orden])
}
