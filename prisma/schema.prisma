generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  COORDINATOR
  ADMIN
}

enum SnapshotProcessingStatus {
  IN_REVIEW
  PROCESSED
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id         String         @id @default(cuid())
  name       String         @unique
  description String        @default("")
  economicSector String     @default("")
  classification String     @default("")
  headcount String          @default("")
  revenueUSD String         @default("")
  avgProfitPercent String   @default("")
  hrName String             @default("")
  hrPosition String         @default("")
  hrEmail String            @default("")
  hrPhone String            @default("")
  hrCell String             @default("")
  minVacationDays String    @default("")
  minUtilityDays String     @default("")
  conversionRate String     @default("")
  locality String           @default("")
  users           User[]
  snapshots       UserSnapshot[]
  positions       UserPosition[]
  editRequests    EditRequest[]
  estudioCargos   EstudioCargo[]
  estudioInformes EstudioInforme[]
  estudioEnabled      Boolean @default(false)
  estudioSnapshotIds  String  @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role         UserRole @default(USER)
  name         String
  email        String
  passwordHash  String
  passwordPlain String?
  workspace     UserWorkspace?
  snapshots    UserSnapshot[]
  positions    UserPosition[]
  editRequests EditRequest[]
  lastLoginAt     DateTime?
  sessionVersion  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([email, companyId])
}

model UserWorkspace {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inflation          Float    @default(5)
  snapshotsJson      String   @default("{}")
  selectedSnapshotId String?
  companyInfoJson    String   @default("{}")
  lastExportAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model UserSnapshot {
  id         String         @id @default(cuid())
  userId     String
  companyId  String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshotId String
  label      String
  date       DateTime
  status     SnapshotProcessingStatus @default(IN_REVIEW)
  processedAt DateTime?
  submittedAt DateTime?
  positions  UserPosition[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, snapshotId])
  @@index([companyId, date])
}

model UserPosition {
  id            String   @id @default(cuid())
  userId        String
  companyId     String
  userSnapshotId String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshot      UserSnapshot @relation(fields: [userSnapshotId], references: [id], onDelete: Cascade)
  snapshotId    String
  snapshotLabel String
  snapshotDate  DateTime
  positionId    String
  title         String?
  dataJson      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, snapshotId, positionId])
  @@index([userId, snapshotDate])
  @@index([companyId, snapshotDate])
  @@index([userSnapshotId])
}

model GlobalConfig {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model EditRequest {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshotId     String
  reason         String?
  status         EditRequestStatus @default(PENDING)
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([snapshotId, status])
  @@index([companyId])
  @@index([userId, snapshotId, status])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  type        String    @default("aviso")
  published   Boolean   @default(false)
  publishedAt DateTime?
  sortOrder   Int       @default(0)
  mediaData   String?
  mediaUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


/// Lista de cargos propia de una empresa para el Estudio Especializado.
/// Es independiente de la data que la empresa le reporta al mercado
/// (UserPosition): esa es por corte y con el catálogo cerrado del corte; esta es
/// una sola por empresa, con sus propios nombres, y persiste entre estudios.
model EstudioCargo {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departamento     String   @default("")
  tituloCargo      String
  descripcion      String   @default("")
  hayGrade         Int?
  capriFamily      String?
  /// Estructura de compensación, con la misma forma que UserPosition.dataJson,
  /// para poder reusar la pantalla de compensación y computeRowTotals sin cambios.
  dataJson         String   @default("{}")
  /// manual | importado — de dónde salió el cargo. Un importado es una copia
  /// editable: tocarlo no afecta la data enviada del corte de origen.
  origen           String   @default("manual")
  origenSnapshotId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  equivalencias    EstudioEquivalencia[]

  @@unique([companyId, tituloCargo])
  @@index([companyId])
}

/// A qué cargo del catálogo equivale un cargo del cliente, POR CORTE: cada corte
/// tiene su propio catálogo, así que la equivalencia se guarda por (cargo × corte).
model EstudioEquivalencia {
  id             String       @id @default(cuid())
  estudioCargoId String
  estudioCargo   EstudioCargo @relation(fields: [estudioCargoId], references: [id], onDelete: Cascade)
  snapshotId     String
  departamento   String       @default("")
  tituloCatalogo String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([estudioCargoId, snapshotId])
  @@index([snapshotId])
}


/// Un informe generado por el cliente para un estudio.
///
/// Guarda una FOTO CONGELADA: los cargos con sus montos y los percentiles del
/// mercado tal como estaban al generarlo. Un informe entregado nunca cambia
/// solo — si el cliente corrige un sueldo o se republica el corte, genera uno
/// nuevo, el viejo sigue diciendo lo mismo.
model EstudioInforme {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nombre        String
  snapshotId    String
  snapshotLabel String   @default("")
  /// La foto: filas con montos propios y percentiles de mercado, más con qué
  /// criterio se armó (modo y métrica).
  datosJson     String
  generadoPor   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, createdAt])
}
